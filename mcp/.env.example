# ── Autenticación ─────────────────────────────────────────────────────────────
# Token secreto que va en la URL del conector: https://.../t/<token>/mcp
# Generalo con: openssl rand -hex 32
MCP_ACCESS_TOKEN=reemplaza_con_token_secreto_largo

# Nombre que queda en el campo `usuario` de lo que se carga desde Claude
MCP_USUARIO=claude-mcp

# ── Firebase ───────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=imprenta-online-finanzas

# Solo para desarrollo local. En Cloud Run NO hace falta (usa ADC automáticamente).
# Pegá acá el JSON del service account en UNA SOLA LÍNEA:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── WooCommerce REST API ───────────────────────────────────────────────────────
WC_URL=https://imprentaonline.ar/wp-json/wc/v3
WC_CONSUMER_KEY=ck_REEMPLAZAR
WC_CONSUMER_SECRET=cs_REEMPLAZAR
